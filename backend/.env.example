PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

JWT_SECRET=your_jwt_secret_here
ADMIN_KEY=your_admin_key_here

# ── Email (Resend API — works on Render free tier) ───────
# Gmail SMTP port 465/587 is BLOCKED by Render free tier.
# Use Resend HTTP API instead (free: 100 emails/day)
# 1. Sign up free at https://resend.com
# 2. Dashboard → API Keys → Create API Key
# 3. Paste key below (starts with re_...)
RESEND_API_KEY=re_your_api_key_here
# Optional: verified sender email (default: onboarding@resend.dev)
EMAIL_FROM=noreply@yourdomain.com

FRONTEND_URL=https://meipuratchi.onrender.com

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
